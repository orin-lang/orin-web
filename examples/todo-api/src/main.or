// todo-api: a JSON service written with the annotation layer of orin-web.
//
//   todo-api [port] [token]       serve (default port 8080, token "dev-token")
//   todo-api selftest             run the service against itself through TestClient and exit
//
//   GET    /                        a page
//   GET    /health
//   GET    /api/todos[?done=true]   the todos             (bearer token)
//   GET    /api/todos/{id}
//   POST   /api/todos               {"title":".."}  -> 201
//   POST   /api/todos/{id}/toggle
//   DELETE /api/todos/{id}          -> 204
//   GET    /api/todos/stream        server-sent events
//

import { Host, withProcess, withNet } from "std:host";
import { args } from "std:process";
import { Scope, scopeNet, spawn, channel } from "std:task";
import { NetGrant, netErrorMessage } from "std:net";
import { ServerConfig, ServerHandle, defaultServerConfig, serve } from "orin-web";
import { Command, ownerLoop } from "./state";
import { buildApp } from "./wiring";
import { selftest } from "./selftest";

function main(host: Host): void {
  const argv = withProcess(host, p => args(p));
  if (argv.length > 0 && argv[0] == "selftest") {
    selftest();
    return;
  }
  const port = argv.length > 0 ? parseInt(argv[0]).unwrapOr(8080) : 8080;
  const token = argv.length > 1 ? argv[1] : "dev-token";
  const cfg = ServerConfig { ...defaultServerConfig(), port: port };
  withNet(
    host,
    net => {
      scopeNet(
        net,
        (s: Scope, g: NetGrant): void => {
          const cmds = channel<Command>(64);
          const rx = cmds.rx;
          const owner = spawn(s, () => ownerLoop(rx));
          const done = serve(
            g,
            buildApp(cmds.tx, token),
            cfg,
            (h: ServerHandle) => {
              console.error("listening on http://127.0.0.1:" + h.port.toString());
            },
          );
          if (done.isErr()) {
            console.error("cannot serve: " + netErrorMessage(done.unwrapErr()));
          }
          cmds.tx.close();
          owner.join();
        },
      );
    },
  );
}
