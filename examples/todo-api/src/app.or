// The application: a `Router` built from the pieces of orin-web. Nothing here touches the network; `main.or` serves it and
// `tests/app_test.or` drives it through a `TestClient`.
import { Sender, channel } from "std:task";
import { JsonValue, writeDocument, defaultLimits } from "std:json";
import {
  DecodeError, RejectUnknown, decodeRoot, checkFields, requiredField, decodeString,
} from "std:json/decode";
import {
  Router, Request, Response, WebError, Handler, jsonObject, jsonMember, jsonString, jsonInt,
  jsonBool, jsonArray, logger, cors, defaultCors, bearerToken, decodeBody, notFound, internalError,
  SseEvent, sseData, sseEvent, textAsset, assetsHandler, statusError, unprocessable,
} from "orin-web";
import { Todo } from "./store";
import {
  Command, Reply, Listed, One, Absent, OpList, OpAdd, OpToggle, OpRemove, ask,
} from "./state";

const PAGE: string = "<!doctype html><title>todos</title><h1>todos</h1><p>GET /api/todos with <code>Authorization: Bearer ...</code></p>";

function jsonText(v: JsonValue): string {
  const text = writeDocument(v, defaultLimits());
  return text.isOk() ? text.unwrap() : "{}";
}

function todoJson(t: Todo): JsonValue {
  return jsonObject([
    jsonMember("id", jsonInt(t.id)),
    jsonMember("title", jsonString(t.title)),
    jsonMember("done", jsonBool(t.done)),
  ]);
}

type NewTodo = { title: string; };

function decodeNewTodo(v: JsonValue): Result<NewTodo, DecodeError> {
  const root = decodeRoot(v, defaultLimits())?;
  checkFields(root, ["title"], RejectUnknown)?;
  const title = decodeString(requiredField(root, "title")?)?;
  return Ok(NewTodo { title: title });
}

// The answer of the owner as a todo, or the error the client should see.
function oneTodo(r: Option<Reply>): Result<Todo, WebError> {
  if (r.isNone()) {
    return Err(statusError(503, "shutting down"));
  }
  return match (r.unwrap()) {
    One(t) => Ok(t),
    Absent => Err(notFound("no such todo")),
    Listed(ts) => Err(internalError("unexpected reply")),
  };
}

function listTodos(state: Sender<Command>): Handler {
  return (req: Request): Result<Response, WebError> => {
    const r = ask(state, OpList, 0, "");
    if (r.isNone()) {
      return Err(statusError(503, "shutting down"));
    }
    return match (r.unwrap()) {
      Listed(ts) => Response.json(200, jsonArray(ts.map(t => todoJson(t)))),
      _ => Err(internalError("unexpected reply")),
    };
  };
}

function createTodo(state: Sender<Command>): Handler {
  return (req: Request): Result<Response, WebError> => {
    const body = decodeBody(req, decodeNewTodo)?;
    if (body.title.length == 0 || body.title.length > 200) {
      return Err(unprocessable("title must be 1 to 200 bytes"));
    }
    const t = oneTodo(ask(state, OpAdd, 0, body.title))?;
    const res = Response.json(201, todoJson(t))?;
    return Ok(res.withHeader("Location", "/api/todos/" + t.id.toString()));
  };
}

function toggleHandler(state: Sender<Command>): Handler {
  return (req: Request): Result<Response, WebError> => {
    const id = req.paramInt("id")?;
    return Response.json(200, todoJson(oneTodo(ask(state, OpToggle, id, ""))?));
  };
}

function removeHandler(state: Sender<Command>): Handler {
  return (req: Request): Result<Response, WebError> => {
    const id = req.paramInt("id")?;
    oneTodo(ask(state, OpRemove, id, ""))?;
    return Ok(Response.empty(204));
  };
}

// GET /api/todos/stream: the todos as a server-sent event stream, one `todo` event each, then the stream ends. The handler fills
// a channel and hands the receiving end to `Response.sse`; a producer task that keeps sending would give a live feed the same way.
function streamHandler(state: Sender<Command>): Handler {
  return (req: Request): Result<Response, WebError> => {
    const r = ask(state, OpList, 0, "");
    if (r.isNone()) {
      return Err(statusError(503, "shutting down"));
    }
    const events = channel<SseEvent>(1024);
    match (r.unwrap()) {
      Listed(ts) => {
        for (const t of ts) {
          events.tx.send(sseEvent("todo", jsonText(todoJson(t))));
        }
      },
      _ => {},
    }
    events.tx.close();
    const rx = events.rx;
    return Ok(Response.sse(() => rx.recv()));
  };
}

// buildApp(state, token): Router -- the whole service. `token` is the bearer token of the /api group.
export function buildApp(state: Sender<Command>, token: string): Router {
  // The API group: everything under /api needs the token. A group is a router of its own, mounted under a prefix.
  let api = new Router();
  api.use(bearerToken(token, "admin"));
  api.get("/todos", listTodos(state));
  api.post("/todos", createTodo(state));
  api.get("/todos/stream", streamHandler(state));
  api.post("/todos/:id/toggle", toggleHandler(state));
  api.delete("/todos/:id", removeHandler(state));

  let app = new Router();
  app.use(logger((line: string) => console.error(line)));
  app.use(cors(defaultCors()));
  app.get("/", (req: Request): Result<Response, WebError> => Ok(Response.html(200, PAGE)));
  app.get(
    "/health",
    (req: Request): Result<Response, WebError> => Response.json(
      200,
      jsonObject([jsonMember("status", jsonString("ok"))]),
    ),
  );
  app.get(
    "/assets/*path",
    assetsHandler(
      [textAsset("app.css", "body { font-family: sans-serif; }")],
      "",
      "public, max-age=300",
    ),
  );
  app.mount("/api", api);
  return app;
}
