import { assert, assertEq, assertEqString } from "std:test";
import { Scope, scope, spawn, channel } from "std:task";
import { ValueObject, ValueString, JsonMember } from "std:json";
import {
  Router, TestClient, Response, assertStatus, assertBody, assertHeader, readEvents, jsonObject,
  jsonMember, jsonString,
} from "orin-web";
import { Command, ownerLoop } from "../src/state";
import { buildApp } from "../src/app";

// Runs `body` against the app with its owner task alive.
function withApp(body: (client: TestClient) => void): void {
  scope((s: Scope): void => {
    const cmds = channel<Command>(16);
    const rx = cmds.rx;
    const owner = spawn(s, () => ownerLoop(rx));
    const client = new TestClient(buildApp(cmds.tx, "t0ken")).withHeader(
      "Authorization",
      "Bearer t0ken",
    );
    body(client);
    cmds.tx.close();
    owner.join();
  });
}

@Test
function publicRoutesNeedNoToken(): void {
  scope((s: Scope): void => {
    const cmds = channel<Command>(16);
    const anon = new TestClient(buildApp(cmds.tx, "t0ken"));
    assertBody(anon.get("/health"), "{\"status\":\"ok\"}");
    assertStatus(anon.get("/"), 200);
    assertHeader(anon.get("/assets/app.css"), "Content-Type", "text/css; charset=utf-8");
    const denied = anon.get("/api/todos");
    assertStatus(denied, 401);
    assertHeader(denied, "WWW-Authenticate", "Bearer");
    assertStatus(anon.withHeader("Authorization", "Bearer wrong").get("/api/todos"), 401);
    cmds.tx.close();
  });
}

@Test
function createListToggleDelete(): void {
  withApp((c: TestClient): void => {
    assertBody(c.get("/api/todos"), "[]");
    const created = c.post("/api/todos", "{\"title\":\"milk\"}");
    assertStatus(created, 201);
    assertHeader(created, "Location", "/api/todos/1");
    assertBody(created, "{\"id\":1,\"title\":\"milk\",\"done\":false}");
    c.post("/api/todos", "{\"title\":\"eggs\"}");
    assertBody(c.post("/api/todos/1/toggle", ""), "{\"id\":1,\"title\":\"milk\",\"done\":true}");
    assertBody(
      c.get("/api/todos"),
      "[{\"id\":1,\"title\":\"milk\",\"done\":true},{\"id\":2,\"title\":\"eggs\",\"done\":false}]",
    );
    assertStatus(c.delete("/api/todos/1"), 204);
    assertStatus(c.delete("/api/todos/1"), 404);
    assertStatus(c.post("/api/todos/x/toggle", ""), 404);
    assertStatus(c.post("/api/todos/9/toggle", ""), 404);
  });
}

@Test
function badBodiesAreRefused(): void {
  withApp((c: TestClient): void => {
    assertStatus(c.post("/api/todos", "{"), 400);
    assertStatus(c.post("/api/todos", "{\"title\":1}"), 422);
    assertStatus(c.post("/api/todos", "{\"title\":\"\"}"), 422);
    assertStatus(c.post("/api/todos", "{\"title\":\"a\",\"x\":1}"), 422);
    assertStatus(c.put("/api/todos", "{}"), 405);
  });
}

@Test
function streamEndsWithTheList(): void {
  withApp((c: TestClient): void => {
    c.post("/api/todos", "{\"title\":\"a\"}");
    c.post("/api/todos", "{\"title\":\"b\"}");
    const res = c.get("/api/todos/stream");
    assertHeader(res, "Content-Type", "text/event-stream");
    const events = readEvents(res, 10);
    assertEq(events.length.toInt(), 2, "one event per todo");
    assertEqString(events[0].event.unwrap(), "todo", "event name");
    assertEqString(events[1].data, "{\"id\":2,\"title\":\"b\",\"done\":false}", "payload");
  });
}
