// orin-web: a web framework library for Orin. This file is the public face of the package: `import { Router } from "orin-web";`.
// Everything not listed here is private to the package (MOD-4).

// Errors: handlers return `Result<Response, WebError>`.
export {
  WebErrorKind, WebError, webErrorStatus, webErrorMessage, webError, withErrorHeader, badRequest,
  unauthorized, forbidden, notFound, unprocessable, internalError, statusError,
} from "./error";

// Requests and responses.
export { Request, RequestParts } from "./request";
export { Response, Body, FixedBody, StreamBody } from "./response";
export {
  jsonMember, jsonObject, jsonArray, jsonString, jsonInt, jsonBool, jsonNull,
} from "./jsonbuild";

// Server-sent events.
export {
  SseEvent, sseData, sseEvent, sseEncode, sseComment, sseBytes, parseSseEvents,
} from "./sse";

// Routing.
export {
  Router, Handler, Middleware, ErrorHandler, withMiddleware, chain, defaultErrorResponse,
} from "./router";

// Middleware.
export {
  logger, recover, bearerAuth, bearerToken, constantTimeEquals, limitBody, CorsConfig, defaultCors,
  cors,
} from "./middleware";

// Static responses.
export {
  Asset, contentTypeFor, textAsset, bytesAsset, staticResponse, assetsHandler,
} from "./assets";

// Testing without a socket.
export {
  TestClient, testRequest, readStream, readEvents, assertStatus, assertBody, assertHeader,
  assertNoHeader,
} from "./testing";

// The server (needs a NetGrant).
export { ServerConfig, ServerHandle, defaultServerConfig, serve } from "./server";
